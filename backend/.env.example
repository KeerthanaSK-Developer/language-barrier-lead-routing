# MongoDB
MONGODB_URL=mongodb://localhost:27017

# JWT — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# Email — Railway Hobby/Free blocks SMTP. Use Resend HTTPS in production:
#   1. Create account at https://resend.com
#   2. Add RESEND_API_KEY in Railway Variables
#   3. Verify your domain (or use onboarding@resend.dev for tests only)
#   4. Set FROM_EMAIL to a verified sender
RESEND_API_KEY=
# Local/dev SMTP fallback (Gmail App Password). Ignored when RESEND_API_KEY is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@company.com

# Frontend URL (for email links + CORS)
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated extra browser origins allowed by CORS
# CORS_ORIGINS=https://my-frontend.up.railway.app

# BD Capacity
MAX_ACTIVE_LEADS_PER_BD=3

# Company Settings
COMPANY_NAME=Your Company
COMPANY_DOMAIN=company.com

# Password Generation
PASSWORD_PATTERN=name_phone_random
PASSWORD_RANDOM_LENGTH=3
