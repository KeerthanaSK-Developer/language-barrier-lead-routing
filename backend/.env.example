# MongoDB
MONGODB_URL=mongodb://localhost:27017

# JWT — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# Email Settings (Gmail: use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@company.com

# Frontend URL (for email links + CORS)
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated extra browser origins allowed by CORS
# CORS_ORIGINS=https://my-frontend.up.railway.app

# BD Capacity
MAX_ACTIVE_LEADS_PER_BD=3

# Company Settings
COMPANY_NAME=Your Company
COMPANY_DOMAIN=company.com

# Password Generation
PASSWORD_PATTERN=name_phone_random
PASSWORD_RANDOM_LENGTH=3
