# MongoDB
MONGODB_URL=mongodb://localhost:27017

# JWT — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# Email — Railway Hobby/Free blocks SMTP. Prefer Brevo HTTPS in production:
#   1. Create account at https://www.brevo.com
#   2. Settings → Senders → add & verify your FROM_EMAIL (Gmail OK; click the link)
#   3. Settings → SMTP & API → API Keys → Generate a new API key
#   4. Set BREVO_API_KEY + FROM_EMAIL in Railway Variables
BREVO_API_KEY=
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Your Company

# Local/dev SMTP fallback (Gmail App Password). Ignored when BREVO_API_KEY is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend URL (for email links + CORS)
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated extra browser origins allowed by CORS
# CORS_ORIGINS=https://my-frontend.up.railway.app

# BD Capacity
MAX_ACTIVE_LEADS_PER_BD=3

# Company Settings
COMPANY_NAME=Your Company
COMPANY_DOMAIN=company.com

# Password Generation
PASSWORD_PATTERN=name_phone_random
PASSWORD_RANDOM_LENGTH=3

# AI language detection + insights (OpenAI-compatible Hyrenet — not Bedrock)
AI_BASE_URL=https://ai.hyrenet-staging.in/v1
AI_API_KEY=
AI_MODEL=global.anthropic.claude-sonnet-4-6
AI_TIMEOUT_SECONDS=45

# Local Whisper (faster-whisper) — ffmpeg extracts audio, Whisper turns it into text
# tiny|base|small|medium|large-v3 — use medium+ for Tamil/Hindi (small often garbles Indic)
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CHUNK_SECONDS=600
# Short chunks for Tamil/Hindi/etc (long = Whisper repetition loops)
WHISPER_INDIC_CHUNK_SECONDS=45

# Classify video meetings (createMS + SendAttendanceDetails)
# Header: authorization-key = CLASSIFY_API_KEY
# Body: authToken, product, org_id, label, meetingType, created_by,
#       start_time/givenEndTime (unix int), minDuration, hosts, batch_data,
#       givenStudentPermission
CLASSIFY_URL=
CLASSIFY_API_KEY=
CLASSIFY_AUTH_TOKEN=
CLASSIFY_ORG_ID=a4213e83-097f-4d8e-bfa5-0960f2958c89
CLASSIFY_PRODUCT=guvi
CLASSIFY_CREATOR_EMAIL=
CLASSIFY_TIMEZONE=Asia/Kolkata
CLASSIFY_TIMEOUT_SECONDS=60
